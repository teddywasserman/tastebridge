# Copy to .env.local. Never commit real keys.
# Qloo hackathon key. Leave empty to run with offline mock fixtures.
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# Google AI Studio key for the agent. Leave empty to use the deterministic autopilot.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models tried in order when the main one hits its quota
# GEMINI_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# QLOO_RATE_PER_SEC=4
# RUNS_PER_10_MIN=8
